---
// The action color roles drawn as samples: one row per intent and appearance, one column per state,
// each sample painted with that state's surface, content and border roles of the reader's context.
// Disabled samples are marked informational: inactive components have no contrast minimum (WCAG 1.4.3),
// as in the token contrast reports.
import { cssVar, paths } from '../../lib/tokens';

const all = paths('color.action');
const segment = (i: number) => [...new Set(all.map((p) => p.split('.')[i]))];
const [intents, appearances, states] = [segment(2), segment(3), segment(4)];
---

<div class="ggb-docs-actions not-content">
  <table>
    <thead>
      <tr>
        <th scope="col">Intent · appearance</th>
        {states.map((s) => (
          <th scope="col">{s}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {intents.flatMap((intent) =>
        appearances.map((appearance) => (
          <tr>
            <th scope="row">
              {intent} · {appearance}
            </th>
            {states.map((state) => {
              const role = (r: string) => `var(${cssVar(`color.action.${intent}.${appearance}.${state}.${r}`)})`;
              return (
                <td>
                  <span
                    data-ggb-docs-informational={state === 'disabled' ? '' : undefined}
                    class="sample"
                    style={`background:${role('surface')};color:${role('content')};border-color:${role('border')}`}
                  >
                    Label
                  </span>
                </td>
              );
            })}
          </tr>
        ))
      )}
    </tbody>
  </table>
</div>

<style>
  .ggb-docs-actions {
    margin-block: 1rem 2rem;
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
  }
  th,
  td {
    padding: 0.375rem 0.5rem;
    text-align: start;
    white-space: nowrap;
  }
  thead th {
    color: var(--sl-color-gray-2);
    font-weight: 600;
  }
  tbody th {
    font-weight: 500;
  }
  .sample {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border: var(--ggb-border-width-default) solid;
    border-radius: var(--ggb-radius-control);
    font: var(--ggb-typography-label-sm);
  }
</style>
