{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["astro/client", "node"]
  },
  "include": [
    "astro.config.ts",
    "lib/**/*.ts",
    "src/lib/**/*.ts",
    "src/examples/**/*.svelte",
    "src/components/**/*.svelte"
  ]
}
