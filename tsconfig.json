{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "verbatimModuleSyntax": true, "allowImportingTsExtensions": true, "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"]
  },
  "include": ["packages/svelte/src/**/*.ts", "packages/svelte/src/**/*.svelte", "examples/**/*.ts", "examples/**/*.svelte", "vite.config.ts"]
}
