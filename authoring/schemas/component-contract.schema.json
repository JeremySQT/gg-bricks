{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ggbrick component contract \u2014 v1",
  "description": "Structural schema for the compact contract. Semantic consistency and source token coverage are separate checks (tooling/lib/contract.mjs).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "props", "parts", "states", "tokens", "rules"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "props": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/prop"
      }
    },
    "parts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/part"
      }
    },
    "states": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/state"
      }
    },
    "tokens": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:[a-z][a-zA-Z0-9-]*|\\{[a-z][a-zA-Z0-9]*\\})(?:\\.(?:[a-z0-9][a-zA-Z0-9-]*|\\{[a-z][a-zA-Z0-9]*\\}))*$"
      }
    },
    "rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "events": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "enum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "default"],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "default": {
          "type": "string"
        },
        "bindable": {
          "type": "boolean"
        }
      }
    },
    "boolean": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "const": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "bindable": {
          "type": "boolean"
        }
      }
    },
    "string": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": "string"
        },
        "bindable": {
          "type": "boolean"
        }
      }
    },
    "prop": {
      "oneOf": [
        {
          "$ref": "#/$defs/enum"
        },
        {
          "$ref": "#/$defs/boolean"
        },
        {
          "$ref": "#/$defs/string"
        },
        {
          "$ref": "#/$defs/number"
        }
      ]
    },
    "state": {
      "oneOf": [
        {
          "$ref": "#/$defs/enum"
        },
        {
          "$ref": "#/$defs/boolean"
        }
      ]
    },
    "part": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepts"],
          "properties": {
            "accepts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              }
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "default"],
      "properties": {
        "type": {
          "const": "number"
        },
        "default": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "bindable": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when"],
      "properties": {
        "when": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
