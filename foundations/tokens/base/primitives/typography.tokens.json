        "sans": {
          "$type": "fontFamily",
          "$value": [
            "Inter",
            "system-ui",
            "-apple-system",
            "Segoe UI",
            "Roboto",
            "sans-serif"
          ]
        },
        "mono": {
          "$type": "fontFamily",
          "$value": [
            "IBM Plex Mono",
            "ui-monospace",
            "SFMono-Regular",
            "Menlo",
