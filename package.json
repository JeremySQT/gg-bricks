{
  "name": "ggbrick",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeremySQT/gg-bricks.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "generate": "npm run build:palette && npm run build:tokens && npm run build:svelte",
    "build:palette": "node tooling/generate-palette.ts",
    "build:tokens": "node tooling/build-tokens.ts",
    "build:svelte": "node tooling/build-svelte.ts",
    "validate": "node tooling/validate-contracts.ts --tokens --dependencies && node tooling/check-foundations.ts",
    "check:approvals": "node tooling/check-approvals.ts",
    "test": "node --test tests/*.test.ts",
    "test:ssr": "node --test tests/ssr/*.test.ts",
    "test:browser": "node tooling/test-browser.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./apps/docs/tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run generate && vite build",
    "build:preview": "node tooling/build-preview.ts",
    "dev:docs": "npm run dev --workspace apps/docs",
    "build:docs": "npm run build --workspace apps/docs",
    "pack:svelte": "npm run generate && npm pack --workspace packages/svelte --pack-destination ./dist",
    "pack:tokens": "npm run build:tokens && npm pack --workspace packages/tokens --pack-destination ./dist",
    "new:component": "node tooling/new-component.ts",
    "digest": "node tooling/digest.ts",
    "figma:batches": "node tooling/figma-batches.ts",
    "figma:check": "node tooling/check-figma.ts",
    "verify": "npm run generate && npm run lint && npm run validate && npm run check:approvals && npm test && npm run check && npm run test:ssr && npm run build && npm run build:docs",
    "verify:generated": "npm run generate && npm run validate && git diff --exit-code --stat -- packages reports foundations/tokens/base/primitives/colors.tokens.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.20.4",
    "ajv": "8.17.1",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-svelte": "3.5.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6"
  },
  "dependencies": {
    "bits-ui": "2.19.3",
    "svelte": "5.57.1"
  }
}
