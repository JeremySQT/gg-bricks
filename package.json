{
  "name": "ds-architecture",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "validate": "node tools/validate-contract.mjs contracts/actions/button.contract.json",
    "test": "node --test tests/*.test.mjs",
    "build:tokens": "node tools/build-tokens.mjs && node tools/figma-expectations.mjs",
    "build:svelte": "node tools/build-svelte.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run build:tokens && npm run build:svelte && vite build",
    "test:browser": "playwright test",
    "pack:svelte": "npm pack ./packages/svelte --pack-destination ./dist",
    "test:ssr": "node tools/test-svelte-ssr.mjs",
    "build:preview": "node tools/build-preview.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "ajv": "8.17.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  },
  "dependencies": {
    "bits-ui": "2.19.3",
    "svelte": "5.57.1"
  },
  "version": "0.1.0"
}
