{
  "name": "@ds/tokens",
  "version": "0.1.0",
  "description": "Generated design tokens: CSS custom properties per brand/appearance/density context, resolved JSON maps and the Figma variable manifest.",
  "type": "module",
  "private": true,
  "exports": {
    "./tokens.css": "./tokens.css",
    "./resolved/*": "./resolved/*",
    "./figma-manifest.json": "./figma-manifest.json",
    "./figma-expectations.json": "./figma-expectations.json"
  },
  "files": [
    "tokens.css",
    "resolved",
    "figma-manifest.json",
    "figma-expectations.json",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
