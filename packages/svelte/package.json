{
  "name": "@ggbrick/svelte",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeremySQT/gg-bricks.git",
    "directory": "packages/svelte"
  },
  "description": "Svelte 5 implementation of the JSON-owned design system, built on Bits UI primitives",
  "type": "module",
  "private": true,
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./tokens.css",
    "./docs/*": "./docs/*",
    "./contracts/*": "./contracts/*"
  },
  "files": [
    "src",
    "tokens.css",
    "docs",
    "contracts",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "dependencies": {
    "bits-ui": "^2.19.3"
  }
}
